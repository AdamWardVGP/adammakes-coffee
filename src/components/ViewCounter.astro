---
interface Props {
    slug: string;
}

const { slug } = Astro.props;
---

<p class="view-counter" data-slug={slug}>
    <span class="vc-label">// </span><span class="vc-count">—</span><span class="vc-label"> views</span>
</p>

<script>
    import { db } from "../lib/firebase";
    import { doc, getDoc, runTransaction } from "firebase/firestore";

    const el = document.querySelector<HTMLElement>(".view-counter");
    const countEl = el?.querySelector<HTMLElement>(".vc-count");
    const slug = el?.dataset.slug;

    if (slug && countEl) {
        const sessionKey = `viewed:${slug}`;
        const alreadyCounted = sessionStorage.getItem(sessionKey);
        const ref = doc(db, "page_views", slug);

        if (!alreadyCounted) {
            // First visit this session — increment
            sessionStorage.setItem(sessionKey, "1");
            runTransaction(db, async (tx) => {
                const snap = await tx.get(ref);
                const next = (snap.data()?.views ?? 0) + 1;
                tx.set(ref, { views: next });
                return next;
            })
                .then((count) => {
                    countEl.textContent = count.toLocaleString();
                })
                .catch(() => {});
        } else {
            // Already counted this session — just read the current count
            getDoc(ref)
                .then((snap) => {
                    const views = snap.data()?.views;
                    if (typeof views === "number") {
                        countEl.textContent = views.toLocaleString();
                    }
                })
                .catch(() => {});
        }
    }
</script>

<style>
    .view-counter {
        font-family: "Courier New", monospace;
        font-size: 0.78rem;
        color: var(--text-secondary);
        opacity: 0.6;
        margin: -0.5rem 0 1.5rem;
    }

    .vc-label {
        opacity: 0.7;
    }

    .vc-count {
        color: var(--accent-green);
        font-weight: 700;
    }
</style>
